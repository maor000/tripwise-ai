# Copy this file to .env or set these variables in your hosting provider.
# Never commit real API keys.

PORT=4173

# Travelpayouts / Aviasales. Put these in Vercel Environment Variables, not in GitHub.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_DEFAULT_ORIGIN=TLV
TRAVELPAYOUTS_AFFILIATE_BASE_URL=https://www.aviasales.com/search
PROVIDER_TIMEOUT_MS=9000

# Development only. Never enable this in Production.
ENABLE_MOCK_PROVIDER=false

# HolidayFinder must be connected only through an official API, feed, or written partner agreement.
HOLIDAYFINDER_API_BASE_URL=
HOLIDAYFINDER_API_KEY=
HOLIDAYFINDER_SEARCH_PATH=/api/packages/search

# KAYAK has an affiliate/API program. Fill these after partner approval.
KAYAK_API_BASE_URL=
KAYAK_API_KEY=
KAYAK_SEARCH_PATH=/api/packages/search

# Viator is useful for tours/activities as a commission add-on.
VIATOR_API_BASE_URL=
VIATOR_API_KEY=
VIATOR_SEARCH_PATH=/api/products/search
